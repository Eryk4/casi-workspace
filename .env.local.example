# Skopiuj ten plik jako .env.local i uzupelnij dane swojej skrzynki.
# Dla Google Workspace / Gmail najczesciej sprawdzi sie taki zestaw:

# Opcjonalne oznaczenie wersji widoczne w /api/meta i UI.
# Najwygodniej ustawic automatycznie: python sync_release_id.py
INVOICE_APP_RELEASE_ID=

# Scheduler powiadomien ma dwa niezalezne poziomy opt-in. Ta flaga operacyjna
# pozostaje false, dopoki osobny scheduled job nie zostanie swiadomie aktywowany.
INTERNAL_NOTIFICATION_SCHEDULER_RUNTIME_ENABLED=false

# Provider-neutral staging template (nie jest gotowy do uruchomienia).
# Wszystkie wartosci REPLACE_* ustaw w sekretnym magazynie wybranej platformy.
# Staging nie moze korzystac z lokalnego env, SQLite ani lokalnego storage.
# INVOICE_LOAD_LOCAL_ENV=0
# INVOICE_DB_ENGINE=postgresql
# INVOICE_DATABASE_URL=REPLACE_IN_PLATFORM_SECRET_STORE
# INVOICE_DATABASE_BOOTSTRAP_MODE=validate
# INVOICE_ENABLE_DEMO_SEED=0
# CASI_ALLOW_LOCAL_SANDBOX_RESET=0
# INVOICE_STORAGE_BACKEND=s3
# INVOICE_REQUIRE_DURABLE_STORAGE=true
# INVOICE_S3_REQUIRE_TLS=true
# INVOICE_S3_ENDPOINT_URL=REPLACE_WITH_HTTPS_S3_COMPATIBLE_ENDPOINT
# INVOICE_S3_REGION=REPLACE_WITH_REGION
# INVOICE_S3_BUCKET=REPLACE_WITH_STAGING_BUCKET
# INVOICE_S3_ACCESS_KEY_ID=REPLACE_IN_PLATFORM_SECRET_STORE
# INVOICE_S3_SECRET_ACCESS_KEY=REPLACE_IN_PLATFORM_SECRET_STORE
# INVOICE_S3_PREFIX=casi/staging

# Guardrail resetu lokalnego sandboxu danych.
# Nie ustawiaj tej zmiennej na stale. Uzyj tylko jednorazowo przed `python run.py --reset`
# i tylko dla lokalnego SQLite pod data/.
# CASI_ALLOW_LOCAL_SANDBOX_RESET=1

INVOICE_EMAIL_IMAP_HOST=imap.gmail.com
INVOICE_EMAIL_IMAP_PORT=993
INVOICE_EMAIL_IMAP_USERNAME=twoja_skrzynka@twojadomena.pl
INVOICE_EMAIL_IMAP_PASSWORD=twoje_haslo_aplikacji_google
INVOICE_EMAIL_IMAP_FOLDER=INBOX
INVOICE_EMAIL_IMAP_USE_SSL=1
INVOICE_EMAIL_FETCH_LIMIT=100
INVOICE_EMAIL_AUTOCHECK_ENABLED=0
INVOICE_EMAIL_AUTOCHECK_SECONDS=300

# Google Workspace OAuth dla centralnej skrzynki
# Publiczny adres jest potrzebny do callbacku, wiec lokalnie zwykle bedzie to Railway albo tunel HTTPS.
INVOICE_PUBLIC_BASE_URL=
INVOICE_EMAIL_GOOGLE_CLIENT_ID=
INVOICE_EMAIL_GOOGLE_CLIENT_SECRET=

# Slack webhook do importu dokumentow
INVOICE_SLACK_BOT_TOKEN=
INVOICE_SLACK_SIGNING_SECRET=

# Przypomnienia Telegram
# Nadrzedny kill switch. Sam token Telegram nie uruchamia reminderow.
INVOICE_ENABLE_TELEGRAM_TASK_REMINDERS=0
INVOICE_TASK_REMINDER_POLL_SECONDS=60
INVOICE_TASK_REMINDER_WORKER_POLL_SECONDS=15
INVOICE_TASK_REMINDER_RETRY_MINUTES=15
INVOICE_TASK_REMINDER_PROCESSING_TIMEOUT_MINUTES=10
INVOICE_TASK_REMINDER_MAX_ATTEMPTS=5
